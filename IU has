local function makeToggle(text, key, onChange)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -20, 0, 36)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 14
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Parent = win
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
	local function refresh()
		b.Text = text .. (state[key] and "  [เปิด]" or "  [ปิด]")
		b.BackgroundColor3 = state[key] and Color3.fromRGB(0, 140, 110) or Color3.fromRGB(45, 45, 60)
	end
	refresh()
	b.MouseButton1Click:Connect(function()
		state[key] = not state[key]
		refresh()
		if onChange then onChange(state[key]) end
	end)
end

makeToggle("มองดูบทบาท", "esp")
makeToggle("บิน", "fly")
makeToggle("ทะลุกำแพง", "noclip")
makeToggle("ปาดทีเดียวหายยกเซิฟ", "killArm")
makeToggle("ยิงฆ่าตกร", "shootArm")
makeToggle("ล็อคฆ่าตกร", "lock")

-- ---------- ESP (แดง=มีด / น้ำเงิน=ปืน / เขียว=ไม่มีไอเทม) ----------
local function getHighlight(plr)
	local ch = plr.Character
	if not ch then return end
	local h = ch:FindFirstChild("IUhasHL")
	if not h then
		h = Instance.new("Highlight")
		h.Name = "IUhasHL"
		h.FillTransparency = 0.5
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.Parent = ch
	end
	return h
end

task.spawn(function()
	while true do
		task.wait(0.3)
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player then
				local h = getHighlight(plr)
				if h then
					h.Enabled = state.esp
					if hasTool(plr, "knife") then
						h.FillColor = Color3.fromRGB(255, 0, 0)
					elseif hasTool(plr, "gun") then
						h.FillColor = Color3.fromRGB(0, 100, 255)
					else
						h.FillColor = Color3.fromRGB(0, 255, 0)
					end
				end
			end
		end
	end
end)

-- ---------- บิน : ไปทางที่กล้องหัน เดินไปข้างหน้า = บินไปข้างหน้าตามกล้อง ----------
local controls
pcall(function()
	controls = require(player.PlayerScripts:WaitForChild("PlayerModule")):GetControls()
end)
local SPEED = 60

RunService.Heartbeat:Connect(function()
	local root, hum = getRoot()
	if not root or not hum then return end

	if state.fly then
		local move = controls and controls:GetMoveVector() or Vector3.zero
		local dir = cam.CFrame:VectorToWorldSpace(move)
		root.AssemblyLinearVelocity = dir * SPEED
		hum.PlatformStand = true
		-- เลี้ยวตามทิศกล้อง
		local look = cam.CFrame.LookVector
		root.CFrame = CFrame.lookAt(root.Position, root.Position + Vector3.new(look.X, 0, look.Z))
	else
		if hum.PlatformStand then hum.PlatformStand = false end
	end
end)

-- ---------- ทะลุกำแพง (ถ้าเปิดบินด้วย = ทะลุทุกอย่าง) ----------
RunService.Stepped:Connect(function()
	local ch = player.Character
	if not ch then return end
	if state.noclip or state.fly and state.noclip then
		for _, p in ipairs(ch:GetDescendants()) do
			if p:IsA("BasePart") then p.CanCollide = false end
		end
	end
end)

-- ---------- ล็อคฆ่าตกร ----------
RunService.RenderStepped:Connect(function()
	if not state.lock then return end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and hasTool(plr, "knife") then
			local head = plr.Character and plr.Character:FindFirstChild("Head")
			if head then
				cam.CFrame = CFrame.lookAt(cam.CFrame.Position, head.Position)
				break
			end
		end
	end
end)

-- ---------- ปาดทีเดียว / ยิงฆ่าตกร : ทำงานเมื่อใช้ไอเทม 1 ครั้ง ----------
local hooked = {}
local function hookTool(tool)
	if hooked[tool] or not tool:IsA("Tool") then return end
	hooked[tool] = true
	tool.Activated:Connect(function()
		local n = tool.Name:lower()
		if n:find("knife") and state.killArm then
			remote:FireServer("KillAll")
		elseif n:find("gun") and state.shootArm then
			remote:FireServer("ShootMurderer")
		end
	end)
end

local function watch(container)
	for _, t in ipairs(container:GetChildren()) do hookTool(t) end
	container.ChildAdded:Connect(hookTool)
end

watch(player:WaitForChild("Backpack"))
player.CharacterAdded:Connect(function(ch)
	watch(ch)
	watch(player:WaitForChild("Backpack"))
end)
if player.Character then watch(player.Character) end
]]
