-- ===== 2) LOCALSCRIPT : IUhas_Client =====
-- (คัดลอกส่วนล่างนี้ไปใส่ LocalScript แยกต่างหาก)
------------------------------------------------------------
--[[
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local cam = workspace.CurrentCamera
local remote = ReplicatedStorage:WaitForChild("IUhasEvent")

if not player:GetAttribute("IUAdmin") then
	player:GetAttributeChangedSignal("IUAdmin"):Wait()
	if not player:GetAttribute("IUAdmin") then return end
end

local state = { esp = false, fly = false, noclip = false, killArm = false, shootArm = false, lock = false }

-- ---------- helpers ----------
local function hasTool(plr, keyword)
	keyword = keyword:lower()
	for _, c in ipairs({ plr.Character, plr:FindFirstChild("Backpack") }) do
		if c then
			for _, t in ipairs(c:GetChildren()) do
				if t:IsA("Tool") and t.Name:lower():find(keyword) then return true end
			end
		end
	end
	return false
end

local function getRoot()
	local ch = player.Character
	return ch and ch:FindFirstChild("HumanoidRootPart"), ch and ch:FindFirstChildOfClass("Humanoid")
end

-- ---------- UI ----------
