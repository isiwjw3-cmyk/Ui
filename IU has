Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(1, 0)
local ts = Instance.new("UIStroke", toggleBtn)
ts.Color = Color3.fromRGB(0, 255, 200); ts.Thickness = 2

local win = Instance.new("Frame")
