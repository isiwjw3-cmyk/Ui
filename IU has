--[[
  IU has  -  แผงเครื่องมือแอดมิน/ทดสอบ สำหรับแมพที่ตัวเองสร้างใน Roblox Studio
  แบ่งเป็น 2 สคริปต์ (คัดลอกแยกกัน):

  1) Script (ธรรมดา)  -> วางใน ServerScriptService  ชื่อ "IUhas_Server"
  2) LocalScript      -> วางใน StarterPlayer > StarterPlayerScripts  ชื่อ "IUhas_Client"

  ใส่ UserId ของคุณในลิสต์ ADMINS ทั้ง 2 สคริปต์ (ต้องตรงกัน)
  ไอเทมในแมพต้องตั้งชื่อให้มีคำว่า "Knife" (มีด) หรือ "Gun" (ปืน)
]]

------------------------------------------------------------
-- ===== 1) SERVER SCRIPT : IUhas_Server =====
------------------------------------------------------------
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ADMINS = { 1234567890 } -- <<< ใส่ UserId ของคุณ
local DAMAGE = 100

local remote = Instance.new("RemoteEvent")
remote.Name = "IUhasEvent"
remote.Parent = ReplicatedStorage

local function isAdmin(plr)
	return table.find(ADMINS, plr.UserId) ~= nil
end

local function hasTool(plr, keyword)
	keyword = keyword:lower()
	local containers = { plr.Character, plr:FindFirstChild("Backpack") }
	for _, c in ipairs(containers) do
		if c then
			for _, t in ipairs(c:GetChildren()) do
				if t:IsA("Tool") and t.Name:lower():find(keyword) then
					return true
				end
			end
		end
	end
	return false
end

local function damage(plr)
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 then
		hum:TakeDamage(DAMAGE)
	end
end

Players.PlayerAdded:Connect(function(plr)
	plr:SetAttribute("IUAdmin", isAdmin(plr))
end)
for _, p in ipairs(Players:GetPlayers()) do
	p:SetAttribute("IUAdmin", isAdmin(p))
end

remote.OnServerEvent:Connect(function(plr, action)
	if not isAdmin(plr) then return end

	if action == "KillAll" and hasTool(plr, "knife") then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= plr then damage(p) end
		end
	elseif action == "ShootMurderer" and hasTool(plr, "gun") then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= plr and hasTool(p, "knife") then damage(p) end
		end
	end
end)

